# Production/server settings: copy to .env (mode 600) and fill in. Never commit .env.
# For a local run on your own machine use scripts/dev-up.sh instead, which writes .env from
# .env.local.example with generated secrets (docs/guides/local-development.md).
# On a server, generate every secret with openssl rand on the host itself and never print them
# (docs/deployment.md).
POSTGRES_DB=ticketsys
POSTGRES_USER=ticketsys
# The api refuses to start while this is still the placeholder (PlaceholderSecretGuard).
POSTGRES_PASSWORD=REPLACE_ME_with_openssl_rand_hex_24
# The api connects as the restricted role ticketsys_app with this password (Flyway sets it
# on start). Must differ from POSTGRES_PASSWORD. Also refused while it is the placeholder.
APP_DB_PASSWORD=REPLACE_ME_with_openssl_rand_hex_24

# Core auth. Public URL that links in emails point at (no trailing slash).
TS_PUBLIC_BASE_URL=https://helpdesk.example
# true behind HTTPS (demo, production). A plain-http local run sets this to false, or the
# browser drops the cookies.
TS_SECURE_COOKIES=true
# One-time first-admin setup token, 32+ characters (openssl rand -hex 32). Leave empty to switch
# setup off; it stops working anyway once an admin exists. Never logged. No value is given here.
TS_SETUP_TOKEN=
# Encryption key for MFA secrets at rest, 64 hex characters (openssl rand -hex 32). Required;
# refused while it is the placeholder. Losing it means every supporter must enrol MFA again; keep a
# copy with the database backups' secrets, never in the repo.
TS_DATA_KEY=REPLACE_ME_with_openssl_rand_hex_32
TS_DATA_KEY_ID=k1

# Host path for attachments (bind-mounted into the api at /data/attachments).
ATTACHMENTS_DIR=./data/attachments

# Where the web container listens on the host. Servers: 127.0.0.1 (only the TLS reverse proxy on
# the same host connects; it is what makes trusting X-Forwarded-* safe).
WEB_BIND=127.0.0.1
WEB_PORT=80

# Outbound mail (ADR-020). The dev/demo profiles start Mailpit, a local mail catcher, and the
# api sends everything to it - see docs/30-reliability.md "Outbound mail" for how to view it.
# Production: remove COMPOSE_PROFILES, point SMTP_* at the real mailbox (SMTP_SECURITY=starttls or
# tls; none is refused together with a username/password) and put SMTP_PASSWORD only in .env.
COMPOSE_PROFILES=dev
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURITY=none
SMTP_USERNAME=
# The api refuses to start if this is a REPLACE_ME placeholder (PlaceholderSecretGuard).
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=support@helpdesk.example
MAIL_SUPPORT_NAME=Example MSP Support
# Right-hand side of Message-IDs; empty = the MAIL_FROM_ADDRESS domain.
MAIL_MESSAGE_ID_DOMAIN=
# Mailpit web UI on the host: 127.0.0.1 only.
MAILPIT_UI_BIND=127.0.0.1
MAILPIT_UI_PORT=8025

# true = the nightly retention run only counts and logs (docs/30-reliability.md).
APP_RETENTION_DRY_RUN=false

# Image tag and commit shown by the version endpoint; set them in your deploy process, or leave
# as is for local runs.
APP_IMAGE_TAG=local
GIT_SHA=unknown
