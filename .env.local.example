# Local development settings - the template scripts/dev-up.sh turns into .env on a first run.
# Every placeholder (a name between double at-signs) is filled in by dev-up.sh: secrets with
# `openssl rand`, the rest from its defaults or the environment (docs/guides/local-development.md).
# dev-up.sh never overwrites an existing .env. Plain http on localhost only - for a real server
# use .env.example instead.

# Compose project, container and image names, so a second copy on the same machine does not
# collide (images become ticketsys-api:<project> and ticketsys-web:<project>).
COMPOSE_PROJECT_NAME=@@PROJECT@@
TS_CONTAINER_PREFIX=@@PROJECT@@
APP_IMAGE_TAG=@@PROJECT@@

# Database. The api connects as the restricted role ticketsys_app (APP_DB_PASSWORD); Flyway
# migrates as the owner role (POSTGRES_PASSWORD).
POSTGRES_DB=ticketsys
POSTGRES_USER=ticketsys
POSTGRES_PASSWORD=@@POSTGRES_PASSWORD@@
APP_DB_PASSWORD=@@APP_DB_PASSWORD@@

# Plain http on localhost: cookies without the Secure flag, links in emails point here.
TS_PUBLIC_BASE_URL=http://localhost:@@WEB_PORT@@
TS_SECURE_COOKIES=false
# One-time token for creating the first admin at /setup. It stops working once an admin exists.
TS_SETUP_TOKEN=@@TS_SETUP_TOKEN@@
# Encryption key for MFA secrets at rest (64 hex characters).
TS_DATA_KEY=@@TS_DATA_KEY@@
TS_DATA_KEY_ID=k1

# Attachments live in the named volume "attachments" (removed by scripts/dev-down.sh --wipe).
ATTACHMENTS_DIR=attachments

# The web UI, on this machine only.
WEB_BIND=127.0.0.1
WEB_PORT=@@WEB_PORT@@

# Outbound mail goes to Mailpit, a local mail catcher (the dev profile); nothing leaves the machine.
COMPOSE_PROFILES=dev
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURITY=none
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=support@helpdesk.example
MAIL_SUPPORT_NAME=Example Support
MAIL_MESSAGE_ID_DOMAIN=
MAILPIT_UI_BIND=127.0.0.1
MAILPIT_UI_PORT=@@MAILPIT_PORT@@

APP_RETENTION_DRY_RUN=false
